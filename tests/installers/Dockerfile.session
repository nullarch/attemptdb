# Disposable Linux/x86_64 fixture. No production credentials or host home.
# Build from the repository root and run without mounting user directories:
# docker build --platform linux/amd64 -f tests/installers/Dockerfile.session -t attempt-session-test .
# docker run --name attempt-session-test attempt-session-test
# docker cp attempt-session-test:/workspace/install-smoke-results /tmp/attempt-session-results
FROM --platform=linux/amd64 python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates util-linux && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/attempt-test
ARG CLIENT_VERSION=0.2.9
RUN set -eu; \
    stem="attemptdb-server-${CLIENT_VERSION}-x86_64-unknown-linux-musl"; \
    base="https://github.com/nullarch/attemptdb/releases/download/v${CLIENT_VERSION}"; \
    curl -fsSL "$base/$stem.tar.gz" -o "$stem.tar.gz"; \
    curl -fsSL "$base/SHA256SUMS" -o SHA256SUMS; \
    grep " $stem.tar.gz$" SHA256SUMS | sha256sum -c -; \
    tar -xzf "$stem.tar.gz"; \
    cp "$stem/attemptdb-server" ./attemptdb-server
WORKDIR /workspace
COPY docs/migration/ docs/migration/
COPY tests/installers/ tests/installers/
ENV RUNNER_TEMP=/tmp ATTEMPTDB_NO_AUTO_UPDATE=1
CMD ["python", "tests/installers/platform_smoke.py", "--server", "/opt/attempt-test/attemptdb-server", "--linux-session"]
