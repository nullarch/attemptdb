{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AttemptDB",
  "identifier": "dev.attemptdb.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AttemptDB",
        "width": 720,
        "height": 640,
        "minWidth": 600,
        "minHeight": 480,
        "center": true,
        "visible": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#15171f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "copyright": "Apache-2.0 \u2014 github.com/nullarch/attemptdb",
    "shortDescription": "The database for what your coding agents tried",
    "longDescription": "Installs and wires AttemptDB on this machine and opens the local Agent Timeline. Nothing leaves the machine.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/attempt",
      "binaries/attempt-hook"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 420
        },
        "appPosition": {
          "x": 180,
          "y": 190
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 190
        }
      }
    }
  }
}
